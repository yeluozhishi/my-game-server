<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.whk</groupId>
        <artifactId>my-game-server</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>common</artifactId>

    <packaging>pom</packaging>

    <properties>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <modules>
        <module>util</module>
        <module>navmesh</module>
        <module>datasource</module>
        <module>script-core</module>
        <module>script-gate</module>
        <module>script-game</module>
        <module>script-scene</module>
        <module>redis</module>
        <module>protobuf</module>

    </modules>

    <build>
        <plugins>
            <!-- 配置编译器插件指定JDK版本 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version> <!-- 使用最新稳定版本 -->
                <configuration>
                    <!-- 源代码兼容性版本 -->
                    <source>21</source>
                    <!-- 目标字节码兼容性版本 -->
                    <target>21</target>
                    <!-- 指定JDK工具路径（可选，自动检测不到时配置） -->
                    <executable>C:\Users\admin\.jdks\jdk-21.0.9\bin\javac</executable>
                    <fork>false</fork> <!-- 必须设置为true才能使用指定的executable -->
                    <!-- 编码设置 -->
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <plugin>
                <!-- 打包时将jar包复制到指定目录 -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <!-- 指定打包的jar包输出路径 -->
                    <outputDirectory>${project.parent.basedir}/target/jar</outputDirectory>
                    <!--不打入jar包的文件类型或者路径 -->
                    <!--                    <excludes>-->
                    <!--                        <exclude>**/*.properties</exclude>-->
                    <!--                        <exclude>**/*.xml</exclude>-->
                    <!--                        <exclude>**/*.yml</exclude>-->
                    <!--                        <exclude>static/**</exclude>-->
                    <!--                        <exclude>templates/**</exclude>-->
                    <!--                    </excludes>-->
                </configuration>
            </plugin>
            <plugin>
                <!-- 打包时将依赖的jar包复制到指定目录 -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>package</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <outputDirectory>${project.parent.basedir}/target/lib</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>